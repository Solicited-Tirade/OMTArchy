#!/usr/bin/env python3
"""Fetch an MTA GTFS-realtime subway feed and print upcoming arrivals (plus
any currently-active service alerts for the station's lines) as JSON.

Usage: nyc-subway-status <feedGroup> <stopId> <direction> <routeFilter> <alertRoutes>

  feedGroup    one of 1234567S, ACE, BDFM, G, JZ, NQRW, L, SIR
  stopId       GTFS parent stop_id, e.g. "127" (no N/S suffix). Can be a
               comma-separated list of stop_ids sharing this feedGroup, to
               track every platform of a multi-line complex at once (e.g.
               Grand Central's 4/5/6, 7, and S platforms) as a single board.
  direction    "both", "N", or "S"
  routeFilter  comma-separated route ids to fetch, e.g. "1,2,3" ("" = all)
  alertRoutes  comma-separated route ids to check for service alerts, e.g.
               "N,Q,R,W" (typically every route serving this stop; "" skips
               the alerts fetch entirely)

Prints {"arrivals": [{"route","dir","minutes","epoch"}, ...], "alerts":
[{"routes": [...], "header": "..."}, ...]}, or {"error": "..."} on failure.
No API key needed: MTA subway GTFS-realtime feeds have been open since 2019.
"""
import json
import os
import sys
import time
import urllib.error
import urllib.request

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import gtfs_realtime_pb2 as gtfs  # noqa: E402

FEED_PATHS = {
    "1234567S": "gtfs",
    "ACE": "gtfs-ace",
    "BDFM": "gtfs-bdfm",
    "G": "gtfs-g",
    "JZ": "gtfs-jz",
    "NQRW": "gtfs-nqrw",
    "L": "gtfs-l",
    "SIR": "gtfs-si",
}

FEED_BASE = "https://api-endpoint.mta.info/Dataservice/mtagtfsfeeds/nyct%2F"
ALERTS_URL = "https://api-endpoint.mta.info/Dataservice/mtagtfsfeeds/camsys%2Fall-alerts"

# Cap on returned arrival rows: presentation-level slicing (per-direction
# max, etc.) is left to the plugin's Model.js.
MAX_ROWS = 40
MAX_ALERTS = 5
# Stops embedded per arrival for "tap a train, see its whole trip" — a full
# end-to-end trip rarely needs more than this to be useful, and it bounds
# the response size across up to MAX_ROWS arrivals each carrying their own list.
MAX_STOPS_PER_TRIP = 25


def fail(reason, detail=""):
    print(json.dumps({"error": reason, "detail": str(detail)}))


def fetch_feed(url, timeout=10):
    req = urllib.request.Request(url, headers={"User-Agent": "omarchy-nyc-subway-plugin/1.0"})
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        raw = resp.read()
    feed = gtfs.FeedMessage()
    feed.ParseFromString(raw)
    return feed


def stop_time(stop_time_update):
    """The best available time for one stop_time_update, or None."""
    if stop_time_update.HasField("arrival") and stop_time_update.arrival.time:
        return stop_time_update.arrival.time
    if stop_time_update.HasField("departure") and stop_time_update.departure.time:
        return stop_time_update.departure.time
    return None


def fetch_arrivals(feed_group, stop_id, direction, route_filter):
    path = FEED_PATHS.get(feed_group, FEED_PATHS["1234567S"])
    feed = fetch_feed(FEED_BASE + path)

    # A comma-separated stop_id tracks every platform of a multi-line
    # complex (e.g. Grand Central's 4/5/6, 7, and S) as one board — the
    # caller has already confirmed they all share this feedGroup, so a
    # single feed fetch above covers all of them.
    stop_ids = {s.strip() for s in stop_id.split(",") if s.strip()}
    wanted_routes = {r.strip() for r in route_filter.split(",") if r.strip()}
    now = time.time()
    arrivals = []

    for entity in feed.entity:
        if not entity.HasField("trip_update"):
            continue
        trip_update = entity.trip_update
        route_id = trip_update.trip.route_id
        if wanted_routes and route_id not in wanted_routes:
            continue

        stop_time_updates = trip_update.stop_time_update
        for i, stop_time_update in enumerate(stop_time_updates):
            sid = stop_time_update.stop_id
            if not sid:
                continue
            if sid[-1] in ("N", "S"):
                parent, dir_suffix = sid[:-1], sid[-1]
            else:
                parent, dir_suffix = sid, ""
            if parent not in stop_ids:
                continue
            if direction != "both" and dir_suffix != direction:
                continue

            when = stop_time(stop_time_update)
            if when is None:
                continue

            minutes = round((when - now) / 60)
            if minutes < 0:
                continue

            # The rest of this trip from here on — same list a commuter
            # sees in the reference app when they tap a specific train:
            # "board here, then these are the next stops." Starts with this
            # stop itself (i.e. "board here"), capped so an end-to-end trip
            # can't bloat the response for a widget that mostly cares about
            # the next handful of stops.
            stops = []
            for later in stop_time_updates[i:i + MAX_STOPS_PER_TRIP]:
                later_when = stop_time(later)
                if later_when is None or not later.stop_id:
                    continue
                later_sid = later.stop_id
                later_parent = later_sid[:-1] if later_sid[-1] in ("N", "S") else later_sid
                stops.append({
                    "stopId": later_parent,
                    "minutes": max(0, round((later_when - now) / 60)),
                    "epoch": later_when,
                })

            arrivals.append({
                "route": route_id,
                "dir": dir_suffix,
                "minutes": minutes,
                "epoch": when,
                "stops": stops,
            })

    arrivals.sort(key=lambda a: a["epoch"])
    return arrivals[:MAX_ROWS]


def alert_is_active(alert, now):
    periods = alert.active_period
    if not periods:
        return True  # no window given: treat as always active
    for p in periods:
        start_ok = (not p.start) or p.start <= now
        end_ok = (not p.end) or p.end >= now
        if start_ok and end_ok:
            return True
    return False


def alert_header(alert):
    for translation in alert.header_text.translation:
        if translation.language in ("en", ""):
            return translation.text
    if alert.header_text.translation:
        return alert.header_text.translation[0].text
    return ""


# An alert naming this many distinct routes (out of ~24 subway routes total)
# is a system-wide notice (holiday/weekend schedule, systemwide advisory) —
# not something specific to the station being viewed. A real service
# disruption almost never spans this many unrelated lines at once.
GENERAL_ALERT_ROUTE_THRESHOLD = 8


def fetch_alerts(alert_routes):
    wanted = {r.strip() for r in alert_routes.split(",") if r.strip()}
    if not wanted:
        return [], []

    feed = fetch_feed(ALERTS_URL)
    now = time.time()
    seen_headers = set()
    alerts = []
    general = []

    for entity in feed.entity:
        if not entity.HasField("alert"):
            continue
        if len(alerts) >= MAX_ALERTS and len(general) >= MAX_ALERTS:
            continue
        alert = entity.alert
        # The alerts feed covers every MTA agency in one stream, and their
        # route_id spaces collide — LIRR and Metro-North also use "1", "2",
        # "3", etc., under agency_id "LI"/"MNR" instead of the subway's
        # "MTASBWY". Without this, a Metro-North schedule note reads as a
        # delay on the subway 1/2/3.
        routes = {
            ie.route_id for ie in alert.informed_entity
            if ie.route_id and ie.agency_id in ("", "MTASBWY")
        }
        if not routes or not (routes & wanted):
            continue
        if not alert_is_active(alert, now):
            continue
        header = alert_header(alert).strip()
        if not header or header in seen_headers:
            continue
        seen_headers.add(header)

        if len(routes) >= GENERAL_ALERT_ROUTE_THRESHOLD:
            if len(general) < MAX_ALERTS:
                general.append({"routes": sorted(routes & wanted), "header": header})
        elif len(alerts) < MAX_ALERTS:
            alerts.append({"routes": sorted(routes & wanted), "header": header})

    return alerts, general


def main():
    args = sys.argv[1:]
    feed_group = args[0] if len(args) > 0 else "1234567S"
    stop_id = (args[1] if len(args) > 1 else "").strip()
    direction = args[2] if len(args) > 2 else "both"
    route_filter = args[3] if len(args) > 3 else ""
    alert_routes = args[4] if len(args) > 4 else ""

    if not stop_id:
        return fail("no-stop-id")

    try:
        arrivals = fetch_arrivals(feed_group, stop_id, direction, route_filter)
    except urllib.error.URLError as e:
        return fail("fetch-failed", e)
    except Exception as e:  # noqa: BLE001 - report any failure, never crash silently
        return fail("parse-failed", e)

    # Alerts are best-effort: a hiccup fetching them shouldn't take down the
    # arrivals board a commuter actually needs to catch their train.
    try:
        alerts, general_alerts = fetch_alerts(alert_routes)
    except Exception:  # noqa: BLE001
        alerts, general_alerts = [], []

    print(json.dumps({"arrivals": arrivals, "alerts": alerts, "generalAlerts": general_alerts}))


if __name__ == "__main__":
    main()
