#!/usr/bin/env python3
"""System-wide line status — the "is the whole system OK?" view: every
subway line, how many of its trains are running right now, and its active
alerts, as JSON.

Usage: nyc-subway-lines

Prints {"lines": [{"route","routeId","label","feed","trains","status",
"alerts": [{"header","kind","period"}, ...]}, ...]}, or {"error": "..."}.
status is the worst thing going on: "delays" (any live problem),
"planned" (only planned work), "good", or "none" (no trains in the feed —
not running right now, e.g. the B at night, or the feed is down).

Fetches all eight subway feeds in parallel, plus the (cached) alerts feed,
so it's meant to run only while the Lines view is open.
"""
import time

import mta_feed

ALERTS_CACHE_SECONDS = 120

# Every line, in MTA service-group order. The three shuttles are separate
# rows here: they're unrelated lines that only share the "S" bullet.
LINES = [
    ("1", "1234567S", ""), ("2", "1234567S", ""), ("3", "1234567S", ""),
    ("4", "1234567S", ""), ("5", "1234567S", ""), ("6", "1234567S", ""),
    ("7", "1234567S", ""), ("GS", "1234567S", "42 St Shuttle"),
    ("A", "ACE", ""), ("C", "ACE", ""), ("E", "ACE", ""), ("H", "ACE", "Rockaway Park Shuttle"),
    ("B", "BDFM", ""), ("D", "BDFM", ""), ("F", "BDFM", ""), ("M", "BDFM", ""), ("FS", "BDFM", "Franklin Av Shuttle"),
    ("G", "G", ""),
    ("J", "JZ", ""), ("Z", "JZ", ""),
    ("N", "NQRW", ""), ("Q", "NQRW", ""), ("R", "NQRW", ""), ("W", "NQRW", ""),
    ("L", "L", ""),
    ("SI", "SIR", "Staten Island Railway"),
]

LINE_IDS = {route_id for route_id, _feed, _label in LINES}


def main():
    mta_feed.limit_memory()
    mta_feed.limit_runtime(mta_feed.HELPER_SECONDS)
    if mta_feed.IMPORT_ERROR is not None:
        return mta_feed.fail("missing-protobuf", mta_feed.IMPORT_ERROR)

    feeds = mta_feed.fetch_feeds(mta_feed.FEED_PATHS.keys())
    if all(isinstance(f, Exception) for f in feeds.values()):
        first = next(iter(feeds.values()))
        return mta_feed.fail(mta_feed.error_reason(first), first)

    trains = {}
    for feed in feeds.values():
        if isinstance(feed, Exception):
            continue
        for entity in feed.entity:
            # Assigned trains only: a schedule entry nobody's driving yet
            # doesn't mean the line is running.
            if entity.HasField("trip_update") and mta_feed.extension(entity.trip_update.trip).get(2, [0])[0] == 1:
                route = mta_feed.base_route(entity.trip_update.trip.route_id)
                trains[route] = trains.get(route, 0) + 1

    alerts_by_route = {}
    headers_by_route = {}
    try:
        alerts_feed = mta_feed.parse_feed(mta_feed.cached_bytes(mta_feed.ALERTS_URL, "subway-alerts.pb", ALERTS_CACHE_SECONDS), "subway-alerts")
        now = time.time()
        for entity in alerts_feed.entity:
            if not entity.HasField("alert") or not mta_feed.alert_is_active(entity.alert, now):
                continue
            alert = entity.alert
            header = mta_feed.clean_text(mta_feed.english_text(alert.header_text).strip(), "subway-alerts")
            if not header:
                continue
            mercury = mta_feed.extension(alert)
            period = mta_feed.clean_text(mta_feed.ext_translated_text(mercury, 8), "subway-alerts", mta_feed.MAX_PERIOD_TEXT)
            if period is None:
                continue
            item = {
                "header": header,
                "kind": mta_feed.alert_kind(mta_feed.ext_text(mercury, 3)),
                "period": period,
            }
            routes = {ie.route_id for ie in alert.informed_entity if ie.route_id and ie.agency_id in ("", "MTASBWY")}
            for route in {mta_feed.base_route(r) for r in routes} & LINE_IDS:
                seen = headers_by_route.setdefault(route, set())
                if header not in seen:
                    seen.add(header)
                    alerts_by_route.setdefault(route, []).append(item)
    except Exception:  # noqa: BLE001 - statuses still useful without alerts
        pass

    lines = []
    for route_id, feed_group, label in LINES:
        alerts = sorted(alerts_by_route.get(route_id, []), key=lambda a: mta_feed.KIND_ORDER[a["kind"]])
        count = trains.get(route_id, 0)
        feed_ok = not isinstance(feeds.get(feed_group), Exception)
        if any(a["kind"] == "delay" for a in alerts):
            status = "delays"
        elif count == 0:
            status = "none" if feed_ok else "unknown"
        elif any(a["kind"] == "planned" for a in alerts):
            status = "planned"
        else:
            status = "good"
        lines.append({
            "route": mta_feed.display_route(route_id),
            "routeId": route_id,
            "label": label,
            "feed": feed_group,
            "trains": count,
            "status": status,
            "alerts": alerts[:6],
        })

    reply = {"lines": lines}
    for keep in (2, 0):
        if len(mta_feed.encode(reply)) <= mta_feed.MAX_OUTPUT_BYTES:
            break
        for line in lines:
            line["alerts"] = line["alerts"][:keep]
    mta_feed.emit(reply)


if __name__ == "__main__":
    main()
